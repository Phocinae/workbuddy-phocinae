{
  "mcpServers": {
    "workbuddy-phocinae": {
      "type": "stdio",
      "command": "python3",
      "args": [
        "scripts/phocinae_mcp.py"
      ],
      "env": {
        "PHOCINAE_ENDPOINT": "${PHOCINAE_ENDPOINT}",
        "PHOCINAE_API_KEY": "${PHOCINAE_API_KEY}",
        "PHOCINAE_TIMEOUT": "${PHOCINAE_TIMEOUT}"
      },
      "timeout": 30000
    }
  }
}
